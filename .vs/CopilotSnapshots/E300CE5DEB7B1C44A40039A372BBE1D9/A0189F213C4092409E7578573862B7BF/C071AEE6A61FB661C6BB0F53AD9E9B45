@page "/"
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<MetroScheduler.Infrastructure.MetroDbContext> DbFactory

@functions {
    private List<MetroScheduler.Domain.Entities.MetroLine> _lines = new();
    private List<MetroScheduler.Domain.Entities.MetroStation> _stations = new();
    private string? _selectedLineId;
    private string? _selectedOriginId;
    private string? _selectedDestId;
    private bool _isHoliday;

    protected override async Task OnInitializedAsync()
    {
        using var db = DbFactory.CreateDbContext();
        _lines = await db.MetroLines.AsNoTracking().OrderBy(l => l.Number).ThenBy(l => l.Name).ToListAsync();
    }

    private async Task OnLineChanged(ChangeEventArgs e)
    {
        _selectedLineId = e.Value?.ToString();
        _selectedOriginId = null; _selectedDestId = null;
        _stations.Clear();
        if (!string.IsNullOrEmpty(_selectedLineId))
        {
            using var db = DbFactory.CreateDbContext();
            _stations = await db.MetroStations.AsNoTracking().Where(s => s.MetroLineId == _selectedLineId)
                .OrderBy(s => s.Name).ToListAsync();
        }
    }
}

<h3>انتخاب‌ها</h3>
<div>
    <label>خط:</label>
    <select @onchange="OnLineChanged">
        <option value="">-- انتخاب خط --</option>
        @foreach (var l in _lines)
        {
            <option value="@l.Id">@l.Name</option>
        }
    </select>
</div>
<div>
    <label>مبدا:</label>
    <select @bind="_selectedOriginId">
        <option value="">-- انتخاب مبدا --</option>
        @foreach (var s in _stations)
        {
            <option value="@s.Id">@s.Name</option>
        }
    </select>
</div>
<div>
    <label>مقصد:</label>
    <select @bind="_selectedDestId">
        <option value="">-- انتخاب مقصد --</option>
        @foreach (var s in _stations)
        {
            <option value="@s.Id">@s.Name</option>
        }
    </select>
</div>
<div>
    <label>تعطیل است؟</label>
    <select @bind="_isHoliday">
        <option value="false">غیر تعطیل</option>
        <option value="true">تعطیل</option>
    </select>
</div>

<hr />
<h4>نمایش زمان‌بندی (بعدا)</h4>
<div id="schedule-grid">
    <!-- جدول زمانبندی در ادامه پیاده می‌شود -->
</div>
