using Microsoft.EntityFrameworkCore;
using MetroScheduler.Infrastructure;
using MetroScheduler.Infrastructure.Services;
using Microsoft.AspNetCore.Localization;
using System.Globalization;

var builder = WebApplication.CreateBuilder(args);

// EF Core SQL Server
var connStr = builder.Configuration.GetConnectionString("Default")
              ?? "Server=(localdb)\\MSSQLLocalDB;Database=MetroScheduler;Trusted_Connection=True;TrustServerCertificate=True;";

builder.Services.AddDbContextFactory<MetroDbContext>(opt =>
    opt.UseSqlServer(connStr));

builder.Services.AddLocalization(options => options.ResourcesPath = "Resources");
builder.Services.AddRazorPages()
    .AddViewLocalization();

// Localization (fa-IR default)
builder.Services.Configure<RequestLocalizationOptions>(options =>
{
    var culture = new CultureInfo("fa-IR");
    options.DefaultRequestCulture = new RequestCulture(culture);
    options.SupportedCultures = new List<CultureInfo> { culture };
    options.SupportedUICultures = new List<CultureInfo> { culture };
});

// Background scheduler every 30 minutes
builder.Services.AddScoped<IMetroUpsertService, MetroUpsertService>();
builder.Services.AddHostedService<PeriodicRefreshHostedService>();

var app = builder.Build();

app.UseRequestLocalization();

// Ensure UTF-8 charset for html responses
app.Use(async (ctx, next) =>
{
    await next();
    if (!string.IsNullOrEmpty(ctx.Response.ContentType) &&
        ctx.Response.ContentType.StartsWith("text/html", StringComparison.OrdinalIgnoreCase) &&
        !ctx.Response.ContentType.Contains("charset", StringComparison.OrdinalIgnoreCase))
    {
        ctx.Response.ContentType += "; charset=utf-8";
    }
});

app.MapRazorPages();
app.MapGet("/health", () => "OK");

app.Run();

public sealed class PeriodicRefreshHostedService : BackgroundService
{
    private readonly IServiceProvider _sp;
    private readonly ILogger<PeriodicRefreshHostedService> _logger;

    public PeriodicRefreshHostedService(IServiceProvider sp, ILogger<PeriodicRefreshHostedService> logger)
    {
        _sp = sp;
        _logger = logger;
    }

    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
    {
        // Run once at startup
        await RunOnce(stoppingToken);

        // Then every 30 minutes
        var timer = new PeriodicTimer(TimeSpan.FromMinutes(30));
        try
        {
            while (await timer.WaitForNextTickAsync(stoppingToken))
            {
                await RunOnce(stoppingToken);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task RunOnce(CancellationToken ct)
    {
        using var scope = _sp.CreateScope();
        var upserter = scope.ServiceProvider.GetRequiredService<IMetroUpsertService>();
        try
        {
            _logger.LogInformation("Starting metro data refresh at {Time}", DateTimeOffset.Now);
            await upserter.RunFullRefreshAsync(ct);
            _logger.LogInformation("Finished metro data refresh at {Time}", DateTimeOffset.Now);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Metro data refresh failed");
        }
    }
}
